+            ["triangles"] = RingsJson(p.Triangles), ["holes"] = RingsJson(p.Holes),
+            ["tolerance"] = new JsonObject { ["absolute_length"] = p.AbsoluteTolerance, ["relative_length"] = p.RelativeTolerance } };
