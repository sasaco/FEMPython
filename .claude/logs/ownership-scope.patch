+            DisplacementComponents: ["rz_max"], SectionForceComponents: ["mz_max"]));
+        JsonObject dispEnvelope = root["disg"]!.AsObject().Single().Value!.AsObject();
+        JsonObject forceEnvelope = root["fsec"]!.AsObject().Single().Value!.AsObject();
