+namespace FrameWebforCS.Tests;
+
+public sealed class TransverseDisplayProjectionTests
+{
+    [Theory]
+    [InlineData("m", 2, 1000, -1)]
+    [InlineData("mm", 2, 1, -1)]
+    [InlineData("cm", 2, 10, -1)]
+    [InlineData("unspecified", 2, 1000, -1)]
