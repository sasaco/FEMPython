+            Assert.Equal(notices, saved["notice_points"]!.ToJsonString());
+        }
+        Assert.Null(JsonNode.Parse(CalculationRequestBuilder.FromSavedJson(Snapshot().ToJsonString()).Json)!["notice_points"]);
