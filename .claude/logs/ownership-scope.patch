+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.RegularExpressions;
+using PDF_Manager.Printing.Comon;
+using PdfSharpCore.Drawing;
+
+namespace PDF_Manager.Printing
+{
+    internal static class ReferenceResultLayout
+    {
+        internal static string Provenance(string source, string expression) =>
+            string.IsNullOrEmpty(expression) ? source ?? "" : "(" + source + " : " + expression + ")";
+
+        private static string CompactProvenance(string source, string expression) =>
+            string.IsNullOrEmpty(expression) ? source ?? "" : "(" + source + ":" +
+                new string(expression.Where(character => !char.IsWhiteSpace(character)).ToArray()) + ")";
+
+        private static List<string> Wrap(PdfDocument document, XFont font, string text, double width)
+        {
+            var lines = new List<string>();
+            string line = "";
+            // Keep a decimal or scientific coefficient readable as one token.
+            // Oversized tokens still wrap by character so long identifiers and
+            // captions cannot prevent pagination from making progress.
+            foreach (Match match in Regex.Matches(text ?? "", @"[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?|[\s\S]"))
+            {
+                string token = match.Value;
+                if (document.gfx.MeasureString(token, font).Width <= width)
+                {
+                    if (line.Length > 0 && document.gfx.MeasureString(line + token, font).Width > width)
+                    { lines.Add(line); line = ""; }
+                    line += token;
+                    continue;
+                }
+                foreach (char character in token)
+                {
+                    if (line.Length > 0 && document.gfx.MeasureString(line + character, font).Width > width)
+                    { lines.Add(line); line = ""; }
+                    line += character;
+                }
+            }
+            lines.Add(line);
+            return lines;
+        }
+
+        private static IReadOnlyList<string[]> WrapPanels(PdfDocument document, XFont font,
+            string[] cells, double[] widths, int[] starts)
+        {
+            var lines = new Dictionary<int, List<string>>();
+            foreach (int column in starts)
+            {
+                int end = starts.FirstOrDefault(next => next > column);
+                if (end == 0) end = widths.Length;
+                lines[column] = Wrap(document, font, cells[column], widths.Skip(column).Take(end - column).Sum() - 12);
+            }
+            var result = new List<string[]>();
+            for (int row = 0; row < lines.Values.Select(value => value.Count).DefaultIfEmpty(1).Max(); row++)
+            {
+                var output = new string[widths.Length];
+                foreach (int column in starts)
+                    if (row < lines[column].Count) output[column] = lines[column][row];
+                result.Add(output);
+            }
+            return result;
+        }
+
+        internal sealed class Row
+        {
+            internal readonly string[] Cells;
+            internal readonly string[] Caption;
+            internal readonly bool IsCaption;
+            internal readonly double Height;
+            internal Row(string[] cells, string[] caption = null, bool isCaption = false, double height = 0)
+            { Cells = cells; Caption = caption; IsCaption = isCaption; Height = height; }
+        }
+
+        internal static bool Portrait(PdfDocument document) => document.currentPage.Width < document.currentPage.Height;
+
+        private static XFont ReportFont(PdfDocument document, PrintData data) =>
+            new XFont(data.language == "cn" ? "SimSun" : "MS Mincho", Portrait(document) ? 9.572 : 10);
+
+        internal static bool Enabled(Dictionary<string, object> root) =>
+            root.TryGetValue("referenceResultLayout", out var enabled) && Convert.ToBoolean(enabled);
+
+        internal static string CaseTitle(string key, string name)
+        {
+            // Canonical lookup keys include result kind and step; report captions do not.
+            int suffix = key.IndexOf("/Static/", StringComparison.Ordinal);
+            string id = suffix < 0 ? key : key.Substring(0, suffix);
+            return "CASE " + id + (name == id ? "" : " " + name);
+        }
+
+        // These are report panels, not Table.Nup's successive rows of the same case.
+        internal static void Print(PdfDocument document, PrintData data, ref int page,
+            string title, string[][] headers, double[] widths, IReadOnlyList<Row> rows,
+            bool newGroup = false, int[] panelStarts = null, bool keepMemberTogether = false,
+            bool headersOnlyAtPageStart = false, bool wrapFirstHeader = true, bool squareViewport = false)
+        {
+            if (rows.Count == 0) return;
+            if (newGroup && !document.currentPos.Equals(document.initialPos)) document.NewPage(ref page);
+            double lineHeight = Portrait(document) ? 9 : 10.5;
+            var font = ReportFont(document, data);
+            // The portrait basic-force reference keeps the compact table viewport;
+            // its tall paper does not expand that report's vertical composition.
+            double pageHeight = squareViewport ? Math.Min(document.currentPage.Height, document.currentPage.Width) : (double)document.currentPage.Height;
+            double scale = document.currentPageSize.Width / widths.Sum();
+            widths = widths.Select(width => width * scale).ToArray();
+            // A case caption can include a long load name and a weighted expression.
+            // Wrap within each panel so it cannot overwrite its neighbour's caption.
+            var starts = panelStarts ?? Enumerable.Range(0, widths.Length).Where(column => !string.IsNullOrEmpty(headers[0][column])).ToArray();
+            if (wrapFirstHeader)
+                headers = WrapPanels(document, font, headers[0], widths, starts).Concat(headers.Skip(1)).ToArray();
+            var captions = new Dictionary<string[], IReadOnlyList<string[]>>();
+            foreach (Row row in rows.Where(row => row.Caption != null))
+                if (!captions.ContainsKey(row.Caption))
+                    captions[row.Caption] = WrapPanels(document, font, row.Caption, widths, starts);
+            var captionHeights = rows.Where(row => row.IsCaption).GroupBy(row => row.Caption)
+                .ToDictionary(group => group.Key, group => group.First().Height);
+            rows = rows.SelectMany(row => row.IsCaption
+                ? captions[row.Caption].Select(cells => new Row(cells, row.Caption, true, row.Height))
+                : new[] { row }).ToArray();
+            double Height(Row row) => row.Height > 0 ? row.Height : lineHeight;
+            int CaptionRows(int index) => rows.Skip(index).TakeWhile(row => row.IsCaption &&
+                ReferenceEquals(row.Caption, rows[index].Caption)).Count();
+            int next = 0;
+            while (next < rows.Count)
+            {
+                document.CheckBudget();
+                bool titleRequired = document.currentPos.Equals(document.initialPos);
+                string[][] pageHeaders = headersOnlyAtPageStart && !titleRequired ? new string[0][] : headers;
+                double available = pageHeight - document.Margine.Bottom - document.currentPos.Y
+                    - (titleRequired ? printManager.LineSpacing2 : 0) - pageHeaders.Length * lineHeight;
+                bool continued = !rows[next].IsCaption && rows[next].Caption != null;
+                double captionHeight = continued ? captionHeights[rows[next].Caption] : 0;
+                if (captionHeight <= 0) captionHeight = lineHeight;
+                double minimumHeight = continued ? captions[rows[next].Caption].Count * captionHeight + Height(rows[next]) :
+                    rows[next].IsCaption ? rows.Skip(next).Take(CaptionRows(next) + 1).Sum(Height) : Height(rows[next]);
+                if (available < minimumHeight)
+                {
+                    if (document.currentPos.Equals(document.initialPos))
+                        throw new InvalidOperationException("A report caption leaves no room for a data row on the selected paper.");
+                    document.NewPage(ref page);
+                    continue;
+                }
+                var pageRows = new List<Row>();
+                if (continued)
+                {
+                    foreach (var continuationCells in captions[rows[next].Caption])
+                        pageRows.Add(new Row(continuationCells, height: captionHeight));
+                    available -= captions[rows[next].Caption].Count * captionHeight;
+                }
+                while (next < rows.Count)
+                {
+                    // Keep a member caption with at least one of its data rows.
+                    if (rows[next].IsCaption)
+                    {
+                        if (available < rows.Skip(next).Take(CaptionRows(next) + 1).Sum(Height)) break;
+                        if (keepMemberTogether)
+                        {
+                            int captionRows = CaptionRows(next);
+                            var block = rows.Skip(next).Take(captionRows).Concat(rows.Skip(next + captionRows).TakeWhile(row => !row.IsCaption));
+                            double blockHeight = block.Sum(Height);
+                            double emptyAvailable = pageHeight - document.Margine.Bottom - document.initialPos.Y
+                                - printManager.LineSpacing2 - headers.Length * lineHeight;
+                            if (blockHeight <= emptyAvailable && blockHeight > available) break;
+                        }
+                    }
+                    if (Height(rows[next]) > available) break;
+                    available -= Height(rows[next]);
+                    pageRows.Add(rows[next++]);
+                }
+                if (pageRows.Count == 0) { document.NewPage(ref page); continue; }
+                var table = new Table(pageHeaders.Length + pageRows.Count, widths.Length) { LineSpacing3 = lineHeight };
+                for (int column = 0; column < widths.Length; column++) table.ColWidth[column] = widths[column];
+                for (int row = 0; row < pageRows.Count; row++) table.RowHeight[pageHeaders.Length + row] = Height(pageRows[row]);
+                var cells = pageHeaders.Concat(pageRows.Select(row => row.Cells)).ToArray();
+                for (int row = 0; row < cells.Length; row++)
+                for (int column = 0; column < cells[row].Length; column++)
+                {
+                    table[row, column] = cells[row][column];
+                    table.AlignX[row, column] = row < pageHeaders.Length || starts.Contains(column) ? "L" : "R";
+                }
+                printManager.printTableContents(document, table, new[] { title }, titleRequired, font);
+                document.addCurrentY(5 - printManager.LineSpacing1);
+                if (next < rows.Count) document.NewPage(ref page);
+            }
+        }
+
+        internal static void Displacements(PdfDocument document, PrintData data, ref int page,
+            string leftTitle, IReadOnlyList<Disg> left, string rightTitle, IReadOnlyList<Disg> right)
+        {
+            var font = ReportFont(document, data);
+            double idWidth = Math.Max(document.gfx.MeasureString("JOINT NO.", font).Width,
+                left.Concat(right).Select(row => document.gfx.MeasureString(row.id ?? "", font).Width).DefaultIfEmpty(0).Max()) + 8;
+            if (idWidth > document.currentPageSize.Width / 2 - 3 * 55)
+                throw new InvalidOperationException("A displacement node ID is too wide for the paired report.");
+            var rows = new List<Row>();
+            string[] caption = null;
+            if (Portrait(document))
+            {
+                caption = new[] { leftTitle, "", "", "", "", rightTitle, "", "", "" };
+                rows.Add(new Row(caption, caption, true, 13.5));
+            }
+            for (int i = 0; i < Math.Max(left.Count, right.Count); i++)
+                rows.Add(new Row(DisplacementCells(i < left.Count ? left[i] : null)
+                    .Concat(new[] { "" }).Concat(DisplacementCells(i < right.Count ? right[i] : null)).ToArray(),
+                    caption, height: Portrait(document) && i == 0 ? 13.5 : 0));
+            if (Portrait(document))
+            {
+                Print(document, data, ref page, "Displacement",
+                    new[] {
+                        new[] { "JOINT NO.", "X-DISP.", "Y-DISP.", "ROTATION", "", "JOINT NO.", "X-DISP.", "Y-DISP.", "ROTATION" },
+                        new[] { "", "(mm)", "(mm)", "(mRad)", "", "", "(mm)", "(mm)", "(mRad)" } },
+                    new[] { idWidth, 75, 75, 75, 20, idWidth, 75, 75, 75 }, rows,
+                    panelStarts: new[] { 0, 5 }, headersOnlyAtPageStart: true, wrapFirstHeader: false);
+                return;
+            }
+            Print(document, data, ref page, "Displacement",
+                new[] {
+                    new[] { leftTitle, "", "", "", "", rightTitle, "", "", "" },
+                    new[] { "JOINT NO.", "X-DISP.", "Y-DISP.", "ROTATION", "", "JOINT NO.", "X-DISP.", "Y-DISP.", "ROTATION" },
+                    new[] { "", "(mm)", "(mm)", "(mRad)", "", "", "(mm)", "(mm)", "(mRad)" } },
+                new[] { idWidth, 75, 75, 75, 20, idWidth, 75, 75, 75 }, rows, panelStarts: new[] { 0, 5 });
+        }
+
+        private static string[] DisplacementCells(Disg row) => row == null ? new[] { "", "", "", "" }
+            : new[] { row.id, printManager.toString(row.dx, 4), printManager.toString(row.dy, 4), printManager.toString(row.rz, 4) };
+
+        internal static void Forces(PdfDocument document, PrintData data, ref int page,
+            string leftTitle, IReadOnlyList<Fsec> left, string rightTitle, IReadOnlyList<Fsec> right,
+            bool envelope, bool newGroup)
+        {
+            double[] widths = envelope ? new double[] { 50, 45, 50, 50, 50, 130, 12, 50, 50, 50, 130 }
+                : new double[] { 50, 50, 75, 75, 75, 20, 50, 50, 75, 75, 75 };
+            var font = new XFont(data.language == "cn" ? "SimSun" : "MS Mincho", 10);
+            double sourceWidth = widths[5] * document.currentPageSize.Width / widths.Sum() - 4;
+            // Include occurrence in the key: equal positions and repeated station IDs may
+            // represent different physical sides and must never be silently collapsed.
+            Dictionary<string, Fsec> Index(IReadOnlyList<Fsec> values)
+            {
+                var occurrences = new Dictionary<string, int>();
+                var index = new Dictionary<string, Fsec>();
+                foreach (var row in values)
+                {
+                    string identity = row.m + "\0" + row.n;
+                    occurrences.TryGetValue(identity, out int occurrence);
+                    occurrences[identity] = occurrence + 1;
+                    index.Add(identity + "\0" + occurrence, row);
+                }
+                return index;
+            }
+            var a = Index(left);
+            var b = Index(right);
+            var keys = a.Keys.Concat(b.Keys.Where(key => !a.ContainsKey(key)));
+            var rows = new List<Row>();
+            string member = null;
+            string[] caption = null;
+            foreach (string key in keys)
+            {
+                a.TryGetValue(key, out var x);
+                b.TryGetValue(key, out var y);
+                Fsec location = x ?? y;
+                if (member != location.m)
+                {
+                    member = location.m;
+                    caption = new string[11];
+                    caption[0] = location.memberCaption ?? "MEMBER " + location.m;
+                    if (!envelope) caption[6] = (y ?? x).memberCaption ?? "MEMBER " + location.m;
+                    rows.Add(new Row(caption, caption, true));
+                }
+                string[] cells;
+                if (envelope)
+                    cells = new[] { location.stationLabel ?? location.n, printManager.toString(location.l, 3) }
+                        .Concat(ForceCells(x, true)).Concat(new[] { "" }).Concat(ForceCells(y, true)).ToArray();
+                else
+                    cells = StationForceCells(x).Concat(new[] { "" }).Concat(StationForceCells(y)).ToArray();
+                if (!envelope) { rows.Add(new Row(cells, caption)); continue; }
+                var sourceA = Wrap(document, font, cells[5], sourceWidth);
+                var sourceB = Wrap(document, font, cells[10], sourceWidth);
+                int lines = Math.Max(sourceA.Count, sourceB.Count);
+                for (int line = 0; line < lines; line++)
+                {
+                    var output = line == 0 ? cells : new string[11];
+                    output[5] = line < sourceA.Count ? sourceA[line] : "";
+                    output[10] = line < sourceB.Count ? sourceB[line] : "";
+                    rows.Add(new Row(output, caption));
+                }
+            }
+            var headers = envelope ? new[] {
+                new[] { leftTitle, "", "", "", "", "", "", rightTitle, "", "", "" },
+                new[] { "", "DIST.", "M", "S", "N", "COM: CASE", "", "M", "S", "N", "COM: CASE" },
+                new[] { "", "(m)", "(kN m)", "(kN)", "(kN)", "", "", "(kN m)", "(kN)", "(kN)", "" } }
+                : new[] {
+                    new[] { leftTitle, "", "", "", "", "", rightTitle, "", "", "", "" },
+                    new[] { "", "DIST.", "M", "S", "N", "", "", "DIST.", "M", "S", "N" },
+                    new[] { "", "(m)", "(kN m)", "(kN)", "(kN)", "", "", "(m)", "(kN m)", "(kN)", "(kN)" } };
+            Print(document, data, ref page, "MEMBER FORCES", headers, widths, rows, newGroup, new[] { 0, envelope ? 7 : 6 });
+        }
+
+        private static string[] StationForceCells(Fsec row) => row == null ? new[] { "", "", "", "", "" }
+            : new[] { row.stationLabel ?? row.n, printManager.toString(row.l, 3) }.Concat(ForceCells(row, false)).ToArray();
+
+        private static string[] ForceCells(Fsec row, bool source)
+        {
+            var values = row == null ? new[] { "", "", "" } : new[] {
+                printManager.toString(row.mz, 2), printManager.toString(row.fy, 2), printManager.toString(row.fx, 2) };
+            return source ? values.Concat(new[] { row == null ? "" : CompactProvenance(row.caseStr, row.comb) }).ToArray() : values;
+        }
+
+        internal static void SingleForces(PdfDocument document, PrintData data, ref int page,
+            string caption, IReadOnlyList<Fsec> forces, bool envelope, bool newGroup)
+        {
+            double[] widths = envelope ? new double[] { 50, 45, 50, 50, 50, 130 } : new double[] { 50, 50, 75, 75, 75 };
+            var font = ReportFont(document, data);
+            double sourceWidth = widths.Last() * document.currentPageSize.Width / widths.Sum() - 4;
+            var rows = new List<Row>();
+            string member = null;
+            string[] memberCaption = null;
+            foreach (var force in forces)
+            {
+                bool first = member != force.m;
+                if (first)
+                {
+                    member = force.m;
+                    memberCaption = new string[widths.Length];
+                    memberCaption[0] = string.IsNullOrEmpty(force.memberCaption) ? "MEMBER " + member : force.memberCaption;
+                    rows.Add(new Row(memberCaption, memberCaption, true, 13.5));
+                }
+                var cells = new[] { string.IsNullOrEmpty(force.stationLabel) ? force.n : force.stationLabel,
+                    printManager.toString(force.l, 3) }.Concat(ForceCells(force, envelope)).ToArray();
+                var source = envelope ? Wrap(document, font, cells.Last(), sourceWidth) : new List<string> { "" };
+                for (int line = 0; line < source.Count; line++)
+                {
+                    var output = line == 0 ? cells : new string[widths.Length];
+                    if (envelope) output[widths.Length - 1] = source[line];
+                    rows.Add(new Row(output, memberCaption, height: first && line == 0 ? 13.5 : 9));
+                }
+            }
+            var heading = new string[widths.Length];
+            heading[0] = caption;
+            var columns = envelope ? new[] { "", "DIST.", "M", "S", "N", "COM: CASE" } : new[] { "", "DIST.", "M", "S", "N" };
+            var units = envelope ? new[] { "", "(m)", "(kN m)", "(kN)", "(kN)", "" } : new[] { "", "(m)", "(kN m)", "(kN)", "(kN)" };
+            Print(document, data, ref page, "MEMBER FORCES", new[] { heading, columns, units }, widths, rows,
+                newGroup, new[] { 0 }, keepMemberTogether: !envelope, squareViewport: !envelope);
+        }
+    }
+}
diff --git a/FrameWebforCS/providers/printing/PrintFoundationOccurrences.cs b/FrameWebforCS/providers/printing/PrintFoundationOccurrences.cs
new file mode 100644
index 0000000..b508489
--- /dev/null
+++ b/FrameWebforCS/providers/printing/PrintFoundationOccurrences.cs
@@ -0,0 +1,181 @@
+using FrameWebforCS.calculation;
+using System.Globalization;
+using System.Text.Json.Nodes;
+
+namespace FrameWebforCS.providers.printing;
+
+/// <summary>Two report occurrences only for proved continuous explicit foundation joins.</summary>
+internal static class PrintFoundationOccurrences
+{
+    internal static void Apply(JsonObject root, JsonObject saved, PrintSnapshot snapshot)
+    {
+        var selected = new[]
+        {
+            (PrintOption.SectionForce, "fsec"),
+            (PrintOption.CombinedSectionForce, "fsecCombine"),
+            (PrintOption.PickupSectionForce, "fsecPickup"),
+        }.Where(item => snapshot.Selection.Options.Contains(item.Item1) && root[item.Item2] is JsonObject).ToArray();
+        if (selected.Length == 0) return;
+        var audit = new JsonObject { ["boundaries"] = new JsonArray() };
+        root["foundationOccurrenceAudit"] = audit;
+        CalculationResultPresentation presentation = snapshot.Result!;
+        var results = presentation.ResultSet.Results.OfType<StaticAnalysisResult>().ToArray();
+        if (presentation.Dimension != 2 || results.Length == 0 ||
+            results.Length != presentation.ResultSet.Results.Count ||
+            presentation.ResultSet.Cases.Any(c => c.Symbol.Contains("LL", StringComparison.OrdinalIgnoreCase)))
+        {
+            audit["status"] = "legacy: unsupported dimension, analysis, or moving-load proof";
+            return;
+        }
+        var sheets = new HashSet<string>(StringComparer.Ordinal);
+        foreach (StaticAnalysisResult result in results)
+        {
+            if (saved["load"]?[result.CaseId] is not JsonObject load)
+            {
+                audit["status"] = "legacy: missing saved case selector";
+                return;
+            }
+            decimal selector = Decimal(load["fix_member"]) ?? 1;
+            if (selector == 0) selector = 1; // Same saved-input default as CalculationRequest.
+            if (selector <= 0 || selector != decimal.Truncate(selector))
+            {
+                audit["status"] = "legacy: invalid foundation sheet selector";
+                return;
+            }
+            sheets.Add(selector.ToString(CultureInfo.InvariantCulture));
+        }
+        var bySheet = new Dictionary<string, Dictionary<string, JsonObject[]>>();
+        foreach (string sheet in sheets)
+        {
+            if (saved["fix_member"]?[sheet] is not JsonArray rows || rows.Any(row => row is not JsonObject))
+            {
+                audit["status"] = "legacy: missing or malformed active foundation sheet";
+                return;
+            }
+            bySheet[sheet] = rows.OfType<JsonObject>().GroupBy(row => Text(row["m"]))
+                .ToDictionary(group => group.Key, group => group.OrderBy(row => Decimal(row["row"]) ?? 0).ToArray());
+        }
+        var canonical = results.Select(result => result.MemberSectionForces.ToDictionary(member => member.MemberId)).ToArray();
+        var proved = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);
+        foreach (TopologyMember member in presentation.ResultSet.Topology.Members)
+        {
+            HashSet<double>? joins = null;
+            bool compatible = true;
+            foreach (var sheet in bySheet.Values)
+            {
+                HashSet<double>? boundaries = sheet.TryGetValue(member.MemberId, out var rows)
+                    ? ExplicitJoins(rows, member.Stations[^1].Position) : null;
+                if (boundaries is null || joins is not null && !joins.SetEquals(boundaries))
+                { compatible = false; break; }
+                joins = boundaries;
+            }
+            if (!compatible || joins is null || joins.Count == 0)
+            {
+                Record(member.MemberId, null, null, "legacy: absent or incompatible explicit interval joins");
+                continue;
+            }
+            var stations = member.Stations.ToDictionary(station => station.Position);
+            var sides = canonical.Select(caseMembers => caseMembers.TryGetValue(member.MemberId, out var forces)
+                ? forces.Segments.Zip(forces.Segments.Skip(1)).ToDictionary(pair => pair.First.StationJ,
+                    pair => (Left: pair.First.JEnd, Right: pair.Second.IEnd,
+                        Adjacent: pair.First.StationJ == pair.Second.StationI)) : null).ToArray();
+            foreach (double position in joins.OrderBy(value => value))
+            {
+                if (!stations.TryGetValue(position, out MemberStation? station))
+                { Record(member.MemberId, position, null, "legacy: declared join has no exact canonical station"); continue; }
+                if (sides.Any(side => side is null || !side.TryGetValue(station.StationId, out var pair) ||
+                    !pair.Adjacent || pair.Left != pair.Right))
+                { Record(member.MemberId, position, station.StationId, "legacy: missing or unequal canonical sides"); continue; }
+                if (!proved.TryGetValue(member.MemberId, out var accepted))
+                    proved[member.MemberId] = accepted = new(StringComparer.Ordinal);
+                accepted.Add(station.StationId);
+                Record(member.MemberId, position, station.StationId, "proved: all static cases have exactly equal six-component sides");
+            }
+        }
+        audit["status"] = proved.Count > 0 ? "proved continuous joins only" : "legacy: no proved joins";
+        var notices = saved["notice_points"] is JsonArray noticeRows ? noticeRows.OfType<JsonObject>() : [];
+        var noticePositions = notices.GroupBy(row => Text(row["m"]))
+            .ToDictionary(group => group.Key, group => group.SelectMany(row => row["Points"] is JsonArray points ? points : new JsonArray())
+                .Select(Decimal).Where(position => position.HasValue).Select(position => (double)position!.Value)
+                .Distinct().OrderBy(position => position).ToArray());
+        var protectedStations = presentation.ResultSet.Topology.Members.Where(member => noticePositions.ContainsKey(member.MemberId))
+            .ToDictionary(member => member.MemberId, member => member.Stations.Where(station =>
+                PrintResultMetadata.LabelPositionIndex(noticePositions[member.MemberId], station.Position,
+                    member.Stations[^1].Position) >= 0).Select(station => station.StationId).ToHashSet());
+        foreach (var (_, key) in selected) Expand(root[key]!);
+
+        void Record(string member, double? position, string? station, string reason) =>
+            audit["boundaries"]!.AsArray().Add(new JsonObject
+            { ["member"] = member, ["position"] = position, ["station"] = station, ["reason"] = reason });
+
+        void Expand(JsonNode node)
+        {
+            if (node is JsonObject obj)
+            {
+                foreach (JsonNode child in obj.Select(pair => pair.Value).OfType<JsonNode>().ToArray()) Expand(child);
+                return;
+            }
+            if (node is not JsonArray rows) return;
+            var counters = new Dictionary<string, int>();
+            JsonNode?[] original = rows.ToArray();
+            rows.Clear();
+            foreach (JsonNode? value in original)
+            {
+                rows.Add(value);
+                if (value is not JsonObject row) continue;
+                string member = Text(row["m"]);
+                if (!proved.TryGetValue(member, out var stationIds)) continue;
+                bool duplicate = stationIds.Contains(Text(row["n"]));
+                Label(row, member);
+                if (duplicate)
+                {
+                    JsonObject copy = row.DeepClone().AsObject();
+                    row["occurrence"] = 1; copy["occurrence"] = 2;
+                    Label(copy, member);
+                    rows.Add(copy);
+                }
+            }
+
+            void Label(JsonObject row, string member)
+            {
+                string label = Text(row["stationLabel"]);
+                if (label is "I-TAN" or "J-TAN") return;
+                int number = counters.GetValueOrDefault(member) + 1;
+                counters[member] = number;
+                bool notice = protectedStations.TryGetValue(member, out var stations) && stations.Contains(Text(row["n"]));
+                if (!notice && int.TryParse(label, NumberStyles.None, CultureInfo.InvariantCulture, out _))
+                    row["stationLabel"] = number.ToString(CultureInfo.InvariantCulture);
+            }
+        }
+    }
+
+    private static HashSet<double>? ExplicitJoins(JsonObject[] rows, double length)
+    {
+        // Decimal cursor preserves declared saved intervals; unmatched canonical stations
+        // are skipped explicitly, with no rounded-distance or tolerance association.
+        var joins = new HashSet<double>();
+        decimal cursor = 0;
+        for (int i = 0; i < rows.Length; i++)
+        {
+            decimal? span = Decimal(rows[i]["length"]);
+            if (span is null)
+            {
+                if (rows[i]["length"] is not null && !string.IsNullOrWhiteSpace(Text(rows[i]["length"]))) return null;
+                if (i != rows.Length - 1 || cursor <= 0 || (double)cursor >= length) return null;
+                joins.Add((double)cursor);
+                return joins;
+            }
+            if (span <= 0) return null;
+            if (i > 0 && (double)cursor < length) joins.Add((double)cursor);
+            cursor += span.Value;
+            if ((double)cursor > length) return null;
+        }
+        return joins;
+    }
+
+    private static string Text(JsonNode? value) => value is JsonValue scalar &&
+        scalar.TryGetValue<string>(out string? text) ? text : value?.ToJsonString() ?? "";
+
+    private static decimal? Decimal(JsonNode? value) => decimal.TryParse(Text(value), NumberStyles.Float,
+        CultureInfo.InvariantCulture, out decimal number) ? number : null;
+}
diff --git a/FrameWebforCS/providers/printing/PrintResultMetadata.cs b/FrameWebforCS/providers/printing/PrintResultMetadata.cs
new file mode 100644
index 0000000..a3c2513
--- /dev/null
+++ b/FrameWebforCS/providers/printing/PrintResultMetadata.cs
@@ -0,0 +1,304 @@
+using FrameWebforCS.calculation;
+using FrameWebforCS.components.input;
+using System.Globalization;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace FrameWebforCS.providers.printing;
+
+/// <summary>Print-only labels and evidence for collapsing ordinary combination rows.</summary>
+internal static class PrintResultMetadata
+{
+    internal static void Apply(JsonObject root, JsonObject saved, PrintSnapshot snapshot)
+    {
+        CalculationResultPresentation presentation = snapshot.Result!;
+        if (presentation.Dimension == 2) root["referenceResultLayout"] = true;
+        AddLabels(root, saved, presentation);
+        var ordinary = new JsonArray();
+        root["ordinaryDisplacementCombinations"] = ordinary;
+        if (snapshot.Derived is null)
+        {
+            PrintFoundationOccurrences.Apply(root, saved, snapshot);
+            return;
+        }
+        using JsonDocument input = JsonDocument.Parse(saved.ToJsonString());
+        var parsed = InputCombineService.ParseCombineJson(input.RootElement);
+        var definitions = CalculationDerivedInputSnapshot.Capture(
+            parsed.Define, parsed.Combine, parsed.Pickup);
+        AddProvenance(root, snapshot, definitions);
+        var staticIds = presentation.ResultSet.Results.OfType<StaticAnalysisResult>()
+            .Select(result => result.CaseId).ToHashSet(StringComparer.Ordinal);
+        var cases = presentation.ResultSet.Cases.ToDictionary(item => item.CaseId, StringComparer.Ordinal);
+        var sourceCounts = definitions.Definitions.ToDictionary(definition => definition.Id,
+            definition => definition.SignedCases.Sum(SourceCount), StringComparer.Ordinal);
+        var combinations = snapshot.Derived.Combines.ToDictionary(item => item.Id);
+        foreach (CalculationDerivedCombinationInput combination in definitions.Combinations)
+        {
+            var terms = combination.Terms.Where(term => term.Coefficient != 0).ToArray();
+            bool singleton = terms.Length > 0 && terms.All(term => definitions.Definitions.Count == 0
+                ? StaticSourceCount(term.Id) == 1 : sourceCounts.GetValueOrDefault(term.Id) == 1);
+            combinations.TryGetValue(combination.Id, out CalculationDerivedCase? item);
+            if (singleton && item is not null && HasOneDisplacementVector(item, presentation.Dimension))
+                ordinary.Add(combination.Id);
+        }
+        PrintFoundationOccurrences.Apply(root, saved, snapshot);
+
+        int SourceCount(int signedCase)
+        {
+            if (signedCase == 0) return staticIds.Count > 0 ? 1 : 0;
+            if (signedCase == int.MinValue) return 0;
+            return StaticSourceCount(Math.Abs(signedCase).ToString(CultureInfo.InvariantCulture));
+        }
+        int StaticSourceCount(string id)
+        {
+            if (!staticIds.Contains(id)) return 0;
+            // Mirror the actual presenter, including its case-sensitive LL expansion.
+            return cases[id].Symbol.Contains("LL", StringComparison.Ordinal)
+                ? 1 + staticIds.Count(child => child.StartsWith(id + ".", StringComparison.Ordinal)) : 1;
+        }
+    }
+
+    private static void AddProvenance(JsonObject root, PrintSnapshot snapshot,
+        CalculationDerivedInputSnapshot input)
+    {
+        CalculationDerivedPresentation derived = snapshot.Derived!;
+        CalculationResultPresentation presentation = snapshot.Result!;
+        var staticIds = presentation.ResultSet.Results.OfType<StaticAnalysisResult>()
+            .Select(result => result.CaseId).ToHashSet(StringComparer.Ordinal);
+        var cases = presentation.ResultSet.Cases.ToDictionary(item => item.CaseId);
+        var combinations = derived.Combines.ToDictionary(item => item.Id);
+        var termsByCombination = input.Combinations.ToDictionary(combination => combination.Id,
+            combination => combination.Terms.Where(term => term.Coefficient != 0).ToArray());
+        var allowedByDefinition = input.Definitions.ToDictionary(definition => definition.Id,
+            definition => definition.SignedCases.SelectMany(signed =>
+                signed == 0 ? new[] { "0" } : signed == int.MinValue ? [] :
+                    Expand(Math.Abs(signed).ToString(CultureInfo.InvariantCulture), signed < 0))
+                .ToHashSet(StringComparer.Ordinal));
+        if (input.Definitions.Count == 0)
+            foreach (string id in termsByCombination.Values.SelectMany(terms => terms.Select(term => term.Id)).Distinct())
+                allowedByDefinition[id] = Expand(id, false).ToHashSet(StringComparer.Ordinal);
+        var combinationRows = new Dictionary<(string Id, string Family, string Mode),
+            Dictionary<(string Entity, string? Station), CalculationDerivedRow>>();
+        var expressionCache = new Dictionary<(string Combination, string Sources), string?>();
+        foreach (var (key, family, pickups) in new[]
+        {
+            ("disgCombine", "disg", false), ("disgPickup", "disg", true),
+            ("reacCombine", "reac", false), ("reacPickup", "reac", true),
+            ("fsecCombine", "fsec", false), ("fsecPickup", "fsec", true),
+        })
+        {
+            if (root[key] is not JsonObject projected) continue;
+            foreach (CalculationDerivedCase item in pickups ? derived.Pickups : derived.Combines)
+            {
+                if (projected[item.Id] is not JsonObject modes) continue;
+                foreach (var (displayMode, rows) in modes)
+                {
+                    string mode = displayMode;
+                    if (family == "reac") mode = mode.Replace("tx_", "fx_").Replace("ty_", "fy_").Replace("tz_", "fz_");
+                    mode = PrintProjection.DisplayMode(mode, family, presentation.Dimension);
+                    if (!Modes(item, family).TryGetValue(mode, out var original)) continue;
+                    var originals = original.ToDictionary(raw => (raw.EntityId, raw.StationId));
+                    foreach (JsonObject row in Records(rows))
+                    {
+                        string entity = Text(row[family == "fsec" ? "m" : "id"]);
+                        string? station = family == "fsec" ? Text(row["n"]) : null;
+                        if (!originals.TryGetValue((entity, station), out CalculationDerivedRow? raw)) continue;
+                        row["rawProvenance"] = raw.Provenance;
+                        string combinationId = pickups ? raw.SourceCaseId : item.Id;
+                        CalculationDerivedRow? source = raw;
+                        if (pickups)
+                        {
+                            var cacheKey = (combinationId, family, mode);
+                            if (!combinationRows.TryGetValue(cacheKey, out var candidates))
+                            {
+                                candidates = combinations.TryGetValue(combinationId, out CalculationDerivedCase? combination) &&
+                                    Modes(combination, family).TryGetValue(mode, out var values)
+                                    ? values.ToDictionary(candidate => (candidate.EntityId, candidate.StationId)) : [];
+                                combinationRows[cacheKey] = candidates;
+                            }
+                            source = candidates.TryGetValue((entity, station), out CalculationDerivedRow? candidate) &&
+                                candidate.Components.Count == raw.Components.Count && raw.Components.All(pair =>
+                                    candidate.Components.TryGetValue(pair.Key, out double value) && value == pair.Value)
+                                ? candidate : null;
+                        }
+                        string? expression = null;
+                        if (source is not null)
+                        {
+                            var cacheKey = (combinationId, source.SourceCaseId);
+                            if (!expressionCache.TryGetValue(cacheKey, out expression))
+                                expressionCache[cacheKey] = expression = Expression(combinationId, source);
+                        }
+                        row["comb"] = expression ?? raw.Provenance;
+                    }
+                }
+            }
+        }
+
+        string? Expression(string id, CalculationDerivedRow source)
+        {
+            if (!termsByCombination.TryGetValue(id, out var terms)) return null;
+            string[] selected = source.SourceCaseId.Split(',');
+            if (selected.Length != terms.Length || terms.Length == 0) return null;
+            var expression = new List<string>();
+            for (int i = 0; i < terms.Length; i++)
+            {
+                if (!allowedByDefinition.TryGetValue(terms[i].Id, out var allowed) || !allowed.Contains(selected[i])) return null;
+                bool negativeSource = selected[i].StartsWith("-", StringComparison.Ordinal);
+                double coefficient = terms[i].Coefficient * (negativeSource ? -1 : 1);
+                string caseId = negativeSource ? selected[i][1..] : selected[i];
+                string magnitude = Math.Abs(coefficient) == 1 ? caseId :
+                    Math.Abs(coefficient).ToString("G", CultureInfo.InvariantCulture) + "*" + caseId;
+                expression.Add(expression.Count == 0 ? (coefficient < 0 ? "-" : "") + magnitude :
+                    (coefficient < 0 ? " - " : " + ") + magnitude);
+            }
+            return string.Concat(expression);
+        }
+
+        string[] Expand(string id, bool negative)
+        {
+            if (!staticIds.Contains(id)) return [];
+            return cases[id].Symbol.Contains("LL", StringComparison.Ordinal)
+                ? [negative ? "-" + id : id, .. presentation.ResultSet.Cases.Select(c => c.CaseId)
+                    .Where(child => staticIds.Contains(child) && child.StartsWith(id + ".", StringComparison.Ordinal))]
+                : [negative ? "-" + id : id];
+        }
+    }
+
+    private static IReadOnlyDictionary<string, IReadOnlyList<CalculationDerivedRow>> Modes(
+        CalculationDerivedCase item, string family) => family switch
+        {
+            "disg" => item.Displacements,
+            "reac" => item.Reactions,
+            _ => item.SectionForces,
+        };
+
+    private static void AddLabels(JsonObject root, JsonObject saved, CalculationResultPresentation presentation)
+    {
+        var pages = presentation.Pages.ToDictionary(page => page.Key);
+        foreach (string family in new[] { "disg", "reac", "fsec" })
+        {
+            if (root[family + "Name"] is not JsonArray names) continue;
+            foreach (JsonArray pair in names.OfType<JsonArray>())
+            {
+                string key = Text(pair[0]);
+                if (!pages.TryGetValue(key, out CalculationResultPage? page)) continue;
+                string name = Text(saved["load"]?[page.Case.CaseId]?["name"]);
+                if (string.IsNullOrWhiteSpace(name)) continue;
+                string original = page.Case.Name.Length == 0 ? page.Case.CaseId : page.Case.Name;
+                string suffix = page.Label.StartsWith(original, StringComparison.Ordinal)
+                    ? page.Label[original.Length..] : "";
+                pair[1] = name + suffix;
+            }
+        }
+        var rigid = Records(saved["rigid"]).GroupBy(row => Text(row["m"]))
+            .ToDictionary(group => group.Key, group => group.ToArray());
+        var notices = Records(saved["notice_points"]).GroupBy(row => Text(row["m"]))
+            .ToDictionary(group => group.Key, group => group.ToArray());
+        var members = presentation.ResultSet.Topology.Members.ToDictionary(member => member.MemberId,
+            member =>
+            {
+                string name = Text(saved["member"]?[member.MemberId]?["name"]);
+                string caption = $"部材 {member.MemberId} ({member.NodeI} - {member.NodeJ})" +
+                    (string.IsNullOrWhiteSpace(name) ? "" : " " + name);
+                return (Caption: caption, Labels: StationLabels(member,
+                    rigid.GetValueOrDefault(member.MemberId) ?? [],
+                    notices.GetValueOrDefault(member.MemberId) ?? []));
+            });
+        foreach (string key in new[] { "fsec", "fsecCombine", "fsecPickup" })
+            if (root[key] is JsonObject family)
+                LabelRows(family);
+
+        void LabelRows(JsonNode node)
+        {
+            if (node is JsonArray array)
+            {
+                foreach (JsonNode? child in array) if (child is not null) LabelRows(child);
+                return;
+            }
+            if (node is not JsonObject obj) return;
+            if (obj.ContainsKey("m") && obj.ContainsKey("n") &&
+                members.TryGetValue(Text(obj["m"]), out var member))
+            {
+                if (!member.Labels.TryGetValue(Text(obj["n"]), out string? label)) return;
+                obj["memberCaption"] = member.Caption;
+                obj["stationLabel"] = label;
+                return;
+            }
+            foreach (JsonNode child in obj.Select(pair => pair.Value).OfType<JsonNode>().ToArray()) LabelRows(child);
+        }
+    }
+
+    private static Dictionary<string, string> StationLabels(TopologyMember member,
+        JsonObject[] rigidRows, JsonObject[] noticeRows)
+    {
+        var labels = new Dictionary<string, string>(StringComparer.Ordinal);
+        if (member.Stations.Count == 0) return labels;
+        double length = member.Stations[^1].Position;
+        double[] rigid = rigidRows.SelectMany(row => new[]
+            {
+                Number(row["Ilength"]) is > 0 and var il ? (double?)il : null,
+                Number(row["Jlength"]) is > 0 and var jl ? (double?)(length - jl) : null,
+            }).Where(value => value.HasValue).Select(value => value!.Value)
+            .Distinct().OrderBy(value => value).ToArray();
+        double[] notices = noticeRows
+            .SelectMany(row => row["Points"] is JsonArray points ? points : new JsonArray())
+            .Select(Number).Where(value => value is > 0 && value < length)
+            .Select(value => value!.Value).Distinct().OrderBy(value => value).ToArray();
+        for (int index = 0; index < member.Stations.Count; index++)
+        {
+            MemberStation station = member.Stations[index];
+            string label;
+            if (index == 0) label = "I-TAN";
+            else if (index == member.Stations.Count - 1) label = "J-TAN";
+            else
+            {
+                int notice = LabelPositionIndex(notices, station.Position, length);
+                bool isRigid = LabelPositionIndex(rigid, station.Position, length) >= 0;
+                label = notice >= 0 ? (notice + 1).ToString(CultureInfo.InvariantCulture) :
+                    index.ToString(CultureInfo.InvariantCulture);
+                if (isRigid) label = notice >= 0 ? label + " 剛域" : "剛域";
+            }
+            labels.Add(station.StationId, label);
+        }
+        return labels;
+
+    }
+
+    // Label association only; foundation occurrence proof never uses this tolerance.
+    internal static int LabelPositionIndex(double[] sorted, double position, double length)
+    {
+        int match = Array.BinarySearch(sorted, position);
+        if (match >= 0) return match;
+        int after = ~match;
+        double tolerance = 1e-10 * Math.Max(1, length);
+        if (after < sorted.Length && Math.Abs(sorted[after] - position) <= tolerance) return after;
+        return after > 0 && Math.Abs(sorted[after - 1] - position) <= tolerance ? after - 1 : -1;
+    }
+
+    private static IEnumerable<JsonObject> Records(JsonNode? node) => node switch
+    {
+        JsonArray array => array.OfType<JsonObject>(),
+        JsonObject obj => obj.Select(pair => pair.Value).OfType<JsonObject>(),
+        _ => [],
+    };
+
+    private static string Text(JsonNode? value) => value is JsonValue scalar &&
+        scalar.TryGetValue<string>(out string? text) ? text : value?.ToJsonString() ?? "";
+
+    private static double? Number(JsonNode? value) => double.TryParse(Text(value),
+        NumberStyles.Float, CultureInfo.InvariantCulture, out double number) && double.IsFinite(number)
+        ? number : null;
+
+    private static bool HasOneDisplacementVector(CalculationDerivedCase item, int dimension)
+    {
+        string[] names = dimension == 2 ? ["dx", "dy", "rz"] : ["dx", "dy", "dz", "rx", "ry", "rz"];
+        string[] expected = names.SelectMany(name => new[] { name + "_max", name + "_min" }).ToArray();
+        if (expected.Any(mode => !item.Displacements.ContainsKey(mode))) return false;
+        var baseline = item.Displacements[expected[0]].ToDictionary(row => (row.EntityId, row.StationId));
+        return baseline.Count > 0 && expected.All(mode =>
+            item.Displacements[mode].Count == baseline.Count && item.Displacements[mode].All(row =>
+                baseline.TryGetValue((row.EntityId, row.StationId), out CalculationDerivedRow? other) &&
+                row.Components.Count == other.Components.Count && row.Components.All(component =>
+                    other.Components.TryGetValue(component.Key, out double value) && value == component.Value)));
+    }
+}
