+        var moment = Assert.Single(pdf.Runs.Where(run => run.Text == "-1000.70"));
+        var vector = pdf.Runs.Where(run => run.Page == moment.Page && Math.Abs(run.Y - moment.Y) < 0.01).ToArray();
+        Assert.Contains(vector, run => run.Text == "700.25");
