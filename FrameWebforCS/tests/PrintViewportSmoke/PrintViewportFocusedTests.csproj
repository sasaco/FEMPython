<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FrameWebforCS.Tests</AssemblyName>
    <BaseOutputPath>bin/focused/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/focused/</BaseIntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <ProjectReference Include="..\..\FrameWebforCS.csproj" />
    <Compile Include="..\PrintViewportCaptureTests.cs" />
    <Compile Include="..\PrintViewportStateTests.cs" />
    <Compile Include="..\DisplacementSingletonCollection.cs" />
  </ItemGroup>
</Project>
